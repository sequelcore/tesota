{
  "name": "tesota",
  "version": "0.0.0",
  "private": true,
  "description": "Makes your coding agent show evidence that its change does what you asked",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "tesota": "dist/cli.js"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "24.15.0"
  },
  "trustedDependencies": [],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run build && vitest run",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings src tests",
    "formal:check": "lsc check --backend=dafny src/verification/check-origin-rule.ts && lsc check --backend=dafny src/verification/proof-cover-rule.ts && lsc check --backend=dafny src/verification/pi-version-rule.ts",
    "check": "bun run typecheck && bun run test && bun run lint"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.1.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "24.10.0",
    "lemmascript": "0.6.4",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
