{
  "name": "tesota",
  "version": "0.0.0",
  "private": true,
  "description": "Tesota: bounded verification and incremental agent development",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "24.15.0"
  },
  "trustedDependencies": [],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run build && vitest run tests --maxWorkers=1 --no-file-parallelism --testTimeout=10000",
    "lint": "oxlint --deny-warnings src tests",
    "check": "bun run build && bun run typecheck && bun run test && bun run lint",
    "start": "bun --no-env-file dist/cli.js",
    "live:codex": "bun --no-env-file dist/live-codex.js --full-probe --stored",
    "live:verification": "bun --no-env-file dist/live-verification.js --stored",
    "live:candidate": "bun --no-env-file dist/live-candidate.js --stored",
    "live:codex:device-code": "bun --no-env-file dist/live-codex.js --full-probe --device-code",
    "auth:codex": "bun --no-env-file dist/cli.js auth login"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "oxlint": "1.82.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1"
  }
}
