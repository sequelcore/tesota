method owner(folders: seq<string>, path: string) returns (res: int)
  ensures (res >= -1)
  ensures (res < |folders|)
  ensures ((res == -1) <==> forall k: nat :: ((k < |folders|) ==> !(holds(folders[k], path))))
  ensures ((res >= 0) ==> holds(folders[res], path))
  ensures ((res >= 0) ==> forall k: nat :: ((k < |folders|) ==> holds(folders[k], path) ==> (|folders[k]| <= |folders[res]|)))
{
  var found := -1;
  var k := 0;
  while (k < |folders|)
    invariant (0 <= k)
    invariant (k <= |folders|)
    invariant (found >= -1)
    invariant (found < k)
    invariant ((found == -1) <==> forall j: nat :: ((j < k) ==> !(holds(folders[j], path))))
    invariant ((found >= 0) ==> holds(folders[found], path))
    invariant ((found >= 0) ==> forall j: nat :: ((j < k) ==> holds(folders[j], path) ==> (|folders[j]| <= |folders[found]|)))
  {
    var i_t0 := holds(folders[k], path);
    if (i_t0 && ((found == -1) || (|folders[k]| > |folders[found]|))) {
      found := k;
    }
    k := (k + 1);
  }
  return found;
}
