function holds(folder: string, path: string): bool
{
  ((folder == "") || (|path| >= |(folder + "/")| && path[..|(folder + "/")|] == (folder + "/")))
}

lemma holds_ensures(folder: string, path: string)
  ensures (holds(folder, path) <==> ((folder == "") || (|path| >= |(folder + "/")| && path[..|(folder + "/")|] == (folder + "/"))))
