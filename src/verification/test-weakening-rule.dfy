  }
  var i := 0;
  while (i < |at|)
    invariant (0 <= i)
    invariant (i <= |at|)
    invariant forall m: nat :: ((m < i) ==> (((0 <= at[m]) && (at[m] < |after|)) && (after[at[m]].text == before[m])))
