function depth(tokens: seq<Token>, lo: int, hi: int): int
  requires (0 <= lo)
  requires (lo <= hi)
  requires (hi <= |tokens|)
  decreases (hi - lo)
{
  if (lo == hi) then
    0
  else
    var kind := tokens[(hi - 1)].kind;
    (depth(tokens, lo, (hi - 1)) + (if kind.open? then 1 else (if kind.close? then -1 else 0)))
}

