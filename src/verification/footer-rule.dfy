function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

function JSRem(a: int, b: int): int
  requires b != 0
{
  var r := (if a < 0 then -a else a) % (if b < 0 then -b else b);
  if a < 0 then -r else r
}

datatype Readiness = proofs_and_tests | proofs_only | tests_only | nothing

datatype EvidenceLevel = full | short | glyphs

datatype FooterLayout = FooterLayout(level: EvidenceLevel, context: bool, model: bool, place: bool)

datatype ElapsedTimeResult = ElapsedTimeResult(minutes: int, seconds: int)

function readiness(contracts: bool, tests: bool): Readiness
{
  if contracts then
    if tests then
      Readiness.proofs_and_tests
    else
      Readiness.proofs_only
  else
    if tests then
      Readiness.tests_only
    else
      Readiness.nothing
}

lemma readiness_ensures(contracts: bool, tests: bool)
  ensures ((readiness(contracts, tests).proofs_and_tests? || readiness(contracts, tests).proofs_only?) <==> contracts)
  ensures ((readiness(contracts, tests).proofs_and_tests? || readiness(contracts, tests).tests_only?) <==> tests)
{
}

function elapsedTime(elapsedMs: int): ElapsedTimeResult
  requires (elapsedMs >= 0)
{
  ElapsedTimeResult(JSFloorDiv(elapsedMs, 60000), JSRem(JSFloorDiv(elapsedMs, 1000), 60))
}

lemma elapsedTime_ensures(elapsedMs: int)
  requires (elapsedMs >= 0)
  ensures (elapsedTime(elapsedMs).minutes >= 0)
  ensures (elapsedTime(elapsedMs).seconds >= 0)
  ensures (elapsedTime(elapsedMs).seconds < 60)
