function fits(width: int, left: int, right: int): bool
  requires (left >= 0)
  requires (right >= 0)
{
  if (right == 0) then
    (left <= width)
  else
    (((left + 2) + right) <= width)
}

lemma fits_ensures(width: int, left: int, right: int)
  requires (left >= 0)
  requires (right >= 0)
  ensures (fits(width, left, right) <==> (if (right == 0) then (left <= width) else (((left + 2) + right) <= width)))
