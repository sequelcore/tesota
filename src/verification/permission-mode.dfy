function nextMode(mode: PermissionMode): PermissionMode
{
  if mode.read_only? then
    PermissionMode.accept_edits
  else
    if mode.accept_edits? then
      PermissionMode.full_access
    else
      PermissionMode.read_only
}

lemma nextMode_ensures(mode: PermissionMode)
  ensures (mode.read_only? ==> nextMode(mode).accept_edits?)
  ensures (mode.accept_edits? ==> nextMode(mode).full_access?)
  ensures (mode.full_access? ==> nextMode(mode).read_only?)
