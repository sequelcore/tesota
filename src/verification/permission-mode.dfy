datatype PermissionMode = read_only | accept_edits | full_access

datatype CommandPlace = sandbox | computer

function editsAllowed(mode: PermissionMode): bool
{
  (!mode.read_only?)
}

lemma editsAllowed_ensures(mode: PermissionMode)
  ensures (editsAllowed(mode) <==> (!mode.read_only?))
{
}

function commandPlace(mode: PermissionMode, sandboxed: bool): CommandPlace
{
  if (mode.full_access? || !(sandboxed)) then
    CommandPlace.computer
  else
    CommandPlace.sandbox
}

lemma commandPlace_ensures(mode: PermissionMode, sandboxed: bool)
  ensures (commandPlace(mode, sandboxed).computer? <==> (mode.full_access? || !(sandboxed)))
{
}

function commandRunsWithoutAsking(mode: PermissionMode, place: CommandPlace, allowedByRule: bool): bool
{
  (mode.full_access? || (if mode.read_only? then false else (place.sandbox? || allowedByRule)))
}

lemma commandRunsWithoutAsking_ensures(mode: PermissionMode, place: CommandPlace, allowedByRule: bool)
  ensures (commandRunsWithoutAsking(mode, place, allowedByRule) <==> (mode.full_access? || (mode.accept_edits? && (place.sandbox? || allowedByRule))))
{
}

