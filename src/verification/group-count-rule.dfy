datatype PartitionWeightsResult = PartitionWeightsResult(inside: int, outside: int)

function weightTotal(values: seq<int>): int
{
  if (|values| == 0) then
    0
  else
    (values[0] + weightTotal(values[1..]))
}

lemma weightTotal_ensures(values: seq<int>)
  ensures ((|values| == 0) ==> (weightTotal(values) == 0))
  ensures ((|values| > 0) ==> (weightTotal(values) == (values[0] + weightTotal(values[1..]))))
{
}

function selectedTotal(selected: seq<bool>, weights: seq<int>): int
  requires (|selected| == |weights|)
{
  if (|weights| == 0) then
    0
  else
    ((if selected[0] then weights[0] else 0) + selectedTotal(selected[1..], weights[1..]))
}

lemma selectedTotal_ensures(selected: seq<bool>, weights: seq<int>)
  requires (|selected| == |weights|)
  ensures ((|weights| == 0) ==> (selectedTotal(selected, weights) == 0))
  ensures ((|weights| > 0) ==> (selectedTotal(selected, weights) == ((if selected[0] then weights[0] else 0) + selectedTotal(selected[1..], weights[1..]))))
{
