method partitionWeights(selected: seq<bool>, weights: seq<int>) returns (res: PartitionWeightsResult)
  requires (|selected| == |weights|)
  ensures ((res.inside + res.outside) == weightTotal(weights))
  ensures (res.inside == selectedTotal(selected, weights))
  ensures ((forall i: nat :: ((i < |selected|) ==> selected[i])) ==> (res.outside == 0))
  ensures ((forall i: nat :: ((i < |selected|) ==> !(selected[i]))) ==> (res.inside == 0))
{
  var inside := 0;
  var outside := 0;
  var k := |weights|;
  while (k > 0)
    invariant (0 <= k)
    invariant (k <= |weights|)
    invariant ((inside + outside) == weightTotal(weights[k..]))
    invariant (inside == selectedTotal(selected[k..], weights[k..]))
    invariant ((forall i: nat :: ((k <= i) ==> (i < |selected|) ==> selected[i])) ==> (outside == 0))
    invariant ((forall i: nat :: ((k <= i) ==> (i < |selected|) ==> !(selected[i]))) ==> (inside == 0))
  {
    k := (k - 1);
    var weight := weights[k];
    if selected[k] {
      inside := (inside + weight);
    } else {
      outside := (outside + weight);
    }
  }
  return PartitionWeightsResult(inside, outside);
}

method sumWeights(weights: seq<int>) returns (res: int)
  ensures (res == weightTotal(weights))
{
  var total := 0;
  var k := |weights|;
  while (k > 0)
    invariant (0 <= k)
    invariant (k <= |weights|)
    invariant (total == weightTotal(weights[k..]))
  {
    k := (k - 1);
    total := (total + weights[k]);
  }
  return total;
}

method conservesCounts(members: seq<int>, violations: seq<int>, edges: seq<int>, groupedMembers: seq<int>, groupedViolations: seq<int>, groupedEdges: seq<int>) returns (res: bool)
  ensures (res <==> (((weightTotal(members) == weightTotal(groupedMembers)) && (weightTotal(violations) == weightTotal(groupedViolations))) && (weightTotal(edges) == weightTotal(groupedEdges))))
{
  var i_t0 := sumWeights(members);
  var i_t1 := sumWeights(groupedMembers);
  var i_t2 := sumWeights(violations);
  var i_t3 := sumWeights(groupedViolations);
  var i_t4 := sumWeights(edges);
  var i_t5 := sumWeights(groupedEdges);
  return (((i_t0 == i_t1) && (i_t2 == i_t3)) && (i_t4 == i_t5));
}
