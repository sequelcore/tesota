lemma SortedLe(numbers: seq<int>, a: nat, b: nat)
  requires a <= b < |numbers|
  requires forall i: nat :: i + 1 < |numbers| ==> numbers[i] < numbers[i + 1]
  ensures numbers[a] <= numbers[b]
  decreases b - a
{
  if a < b {
    SortedLe(numbers, a, b - 1);
    assert numbers[b - 1] < numbers[b];
  }
}

