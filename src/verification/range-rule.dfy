method ranges(numbers: seq<int>) returns (res: seq<Range>)
  requires forall i: nat :: (((i + 1) < |numbers|) ==> (numbers[i] < numbers[(i + 1)]))
  ensures forall r: nat :: ((r < |res|) ==> (res[r].start <= res[r].end))
  ensures forall r: nat :: (((r + 1) < |res|) ==> ((res[r].end + 1) < res[(r + 1)].start))
  ensures forall x: int :: ((exists r: nat :: (((r < |res|) && (res[r].start <= x)) && (x <= res[r].end))) <==> (x in numbers))
{
  var found: seq<Range> := [];
  if (|numbers| == 0) {
    return found;
  }
  var start := numbers[0];
  var end := numbers[0];
  var i_run := 0;
  var k := 1;
  while (k < |numbers|)
    invariant (1 <= k)
    invariant (k <= |numbers|)
    invariant (0 <= i_run)
    invariant (i_run < k)
    invariant (start == numbers[i_run])
    invariant (end == numbers[(k - 1)])
    invariant (start <= end)
    invariant forall i: nat :: (((i + 1) < |numbers|) ==> (numbers[i] < numbers[(i + 1)]))
    invariant forall i: nat :: ((i_run <= i) ==> ((i + 1) < k) ==> ((numbers[i] + 1) == numbers[(i + 1)]))
    invariant forall r: nat :: ((r < |found|) ==> (found[r].start <= found[r].end))
    invariant forall r: nat :: (((r + 1) < |found|) ==> ((found[r].end + 1) < found[(r + 1)].start))
    invariant ((|found| > 0) ==> ((found[(|found| - 1)].end + 1) < start))
    invariant forall x: int :: ((exists r: nat :: (((r < |found|) && (found[r].start <= x)) && (x <= found[r].end))) <==> (x in numbers[0..i_run]))
    invariant forall x: int :: (((start <= x) && (x <= end)) <==> (x in numbers[i_run..k]))
  {
    var number := numbers[k];
    if ((end + 1) == number) {
      end := number;
    } else {
      assert (end < number);
      assert ((end + 1) < number);
      ConsecutiveSlice(numbers, i_run as nat, k as nat);
      AppendRangeMembership(found, numbers, i_run as nat, k as nat, start, end);
      found := (found + [Range(start, end)]);
      start := number;
      end := number;
      i_run := k;
    }
    k := (k + 1);
    ConsecutiveSlice(numbers, i_run as nat, k as nat);
  }
  ConsecutiveSlice(numbers, i_run as nat, k as nat);
  AppendRangeMembership(found, numbers, i_run as nat, k as nat, start, end);
  found := (found + [Range(start, end)]);
  assert numbers[0..k] == numbers;
  assert forall x: int :: ((exists r: nat :: (((r < |found|) && (found[r].start <= x)) && (x <= found[r].end))) <==> (x in numbers));
  return found;
}
