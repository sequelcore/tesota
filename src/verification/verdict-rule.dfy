function checkEnd(kind: string, stale: bool, outcome: ProofOutcome, run: ModelRun, faultPasses: bool): string
{
  if stale then
    "gap"
  else
    if (kind == "model") then
      if (((run.violated? || run.deadlocked?) || run.assumption_failed?) || (run.passed? && faultPasses)) then
        "failed"
