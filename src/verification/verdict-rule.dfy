datatype Standing = decide | gap | holds | opinion

function verdictTone(decisions: int, failed: bool, gaps: int): string
  requires (decisions >= 0)
  requires (gaps >= 0)
{
  if (decisions > 0) then
    if failed then
      "error"
    else
      "warning"
  else
    if (gaps > 0) then
      "warning"
    else
      "success"
}

lemma verdictTone_ensures(decisions: int, failed: bool, gaps: int)
  requires (decisions >= 0)
  requires (gaps >= 0)
  ensures ((verdictTone(decisions, failed, gaps) == "error") <==> ((decisions > 0) && failed))
  ensures ((verdictTone(decisions, failed, gaps) == "success") <==> ((decisions == 0) && (gaps == 0)))
  ensures (((verdictTone(decisions, failed, gaps) == "error") || (verdictTone(decisions, failed, gaps) == "warning")) || (verdictTone(decisions, failed, gaps) == "success"))
{
}

method decisions(standings: seq<Standing>) returns (res: int)
  ensures (0 <= res)
  ensures (res <= |standings|)
  ensures ((res == 0) <==> !(exists k: nat :: ((k < |standings|) && standings[k].decide?)))
{
  var count := 0;
  var k := 0;
  while (k < |standings|)
    invariant (0 <= k)
    invariant (k <= |standings|)
    invariant (0 <= count)
    invariant (count <= k)
    invariant ((count == 0) <==> !(exists j: nat :: ((j < k) && standings[j].decide?)))
  {
    if standings[k].decide? {
      count := (count + 1);
    }
    k := (k + 1);
  }
  return count;
}

method partlyHolds(standings: seq<Standing>) returns (res: bool)
  ensures (res <==> exists k: nat :: ((k < |standings|) && (standings[k].decide? || standings[k].gap?)))
{
  var k := 0;
  while (k < |standings|)
    invariant (0 <= k)
    invariant (k <= |standings|)
    invariant !(exists j: nat :: ((j < k) && (standings[j].decide? || standings[j].gap?)))
  {
    if (standings[k].decide? || standings[k].gap?) {
      return true;
    }
    k := (k + 1);
  }
  return false;
}
