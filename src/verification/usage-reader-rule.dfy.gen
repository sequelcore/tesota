  while (i < route)
    invariant (0 <= i)
    invariant (i <= route)
    invariant forall j: nat :: ((j < i) ==> (accounts[j] != accounts[route]))
  {
    if (accounts[i] == accounts[route]) {
      return i;
    }
    i := (i + 1);
  }
  return route;
}
