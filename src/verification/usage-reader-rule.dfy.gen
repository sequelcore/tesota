  requires (route < |accounts|)
  ensures (0 <= res)
  ensures (res <= route)
  ensures ((accounts[route] == "") ==> (res == route))
  ensures ((accounts[route] != "") ==> (accounts[res] == accounts[route]))
  ensures ((accounts[route] != "") ==> forall j: nat :: ((j < res) ==> (accounts[j] != accounts[route])))
{
  if (accounts[route] == "") {
    return route;
  }
