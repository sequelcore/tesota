function checkAction(verifier: ActionVerifier, outcome: ActionOutcome, origin: ActionCheckOrigin): ReviewAction
{
  if outcome.passed? then
    ReviewAction.context
  else
    if ((!outcome.failed?) && (!outcome.timed_out?)) then
      ReviewAction.operator
    else
      if ((!verifier.command?) || origin.introduced?) then
        ReviewAction.agent
