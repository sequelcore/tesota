datatype ReviewAction = agent | operator | context

datatype ActionOrigin = introduced | preexisting | unknown

datatype ActionDisposition = operator | fixable

datatype ActionStanding = confirmed | refuted | unsettled | untested

datatype ActionVerifier = command | oxlint | lemmascript

datatype ActionOutcome = passed | failed | timed_out | cancelled | not_started | unconfirmed | changed_files

datatype ActionCheckOrigin = introduced | preexisting | unknown | absent

datatype ActionObligation = held | not_held | uncertain

datatype ObligationDisposition = operator | fixable

function findingAction(origin: ActionOrigin, disposition: ActionDisposition, standing: ActionStanding, duplicate: bool): ReviewAction
{
  if ((duplicate || standing.refuted?) || origin.preexisting?) then
    ReviewAction.context
  else
    if ((standing.confirmed? && origin.introduced?) && disposition.fixable?) then
      ReviewAction.agent
    else
      ReviewAction.operator
}

