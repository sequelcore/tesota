method modelOutcome(main: ModelRun, faults: seq<FaultVerdict>) returns (res: ProofOutcome)
  ensures ((!main.passed?) ==> (res == runOutcome(main)))
  ensures (main.passed? ==> (|faults| == 0) ==> res.vacuous?)
  ensures (main.passed? ==> (|faults| > 0) ==> (exists k: nat :: ((k < |faults|) && (faults[k].passes? || faults[k].broken?))) ==> res.failed?)
  ensures (res.passed? <==> ((main.passed? && (|faults| > 0)) && forall k: nat :: ((k < |faults|) ==> (faults[k].caught? || faults[k].unrun?))))
{
  if (!main.passed?) {
    var i_t0 := runOutcome(main);
    return i_t0;
  }
  if (|faults| == 0) {
    return ProofOutcome.vacuous;
  }
  var k := 0;
  while (k < |faults|)
    invariant (0 <= k)
    invariant (k <= |faults|)
    invariant forall j: nat :: ((j < k) ==> (faults[j].caught? || faults[j].unrun?))
  {
    if (faults[k].passes? || faults[k].broken?) {
      return ProofOutcome.failed;
    }
    k := (k + 1);
  }
  return ProofOutcome.passed;
}

method staleness(confirmedFound: bool, changed: seq<bool>) returns (res: Staleness)
  ensures (!(confirmedFound) ==> res.unknown?)
  ensures (res.possibly_stale? <==> (confirmedFound && exists k: nat :: ((k < |changed|) && changed[k])))
  ensures (res.current? <==> (confirmedFound && forall k: nat :: ((k < |changed|) ==> !(changed[k]))))
{
  if !(confirmedFound) {
    return Staleness.unknown;
  }
  var k := 0;
  while (k < |changed|)
    invariant (0 <= k)
    invariant (k <= |changed|)
    invariant forall j: nat :: ((j < k) ==> !(changed[j]))
  {
    if changed[k] {
      return Staleness.possibly_stale;
    }
    k := (k + 1);
  }
  return Staleness.current;
}
