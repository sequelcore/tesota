datatype ModelRun = passed | vacuous | violated | malformed | timed_out | cancelled | not_started

datatype FaultVerdict = caught | passes | broken | unrun

datatype Staleness = current | possibly_stale | unknown

datatype ProofOutcome = passed | vacuous | timed_out | cancelled | not_started | failed

function tlcRun(cancelled: bool, timedOut: bool, started: bool, exitCode: int, states: int): ModelRun
  requires (states >= 0)
{
  if cancelled then
    ModelRun.cancelled
  else
    if timedOut then
      ModelRun.timed_out
    else
      if !(started) then
        ModelRun.not_started
      else
        if (exitCode == 0) then
          if (states > 0) then
            ModelRun.passed
          else
            ModelRun.vacuous
        else
          if ((exitCode >= 10) && (exitCode <= 14)) then
            ModelRun.violated
          else
            if (((exitCode == 75) || (exitCode == 150)) || (exitCode == 151)) then
              ModelRun.malformed
            else
              ModelRun.not_started
}

lemma tlcRun_ensures(cancelled: bool, timedOut: bool, started: bool, exitCode: int, states: int)
  requires (states >= 0)
  ensures (cancelled ==> tlcRun(cancelled, timedOut, started, exitCode, states).cancelled?)
  ensures (!(cancelled) ==> timedOut ==> tlcRun(cancelled, timedOut, started, exitCode, states).timed_out?)
  ensures (tlcRun(cancelled, timedOut, started, exitCode, states).passed? <==> ((((!(cancelled) && !(timedOut)) && started) && (exitCode == 0)) && (states > 0)))
  ensures (tlcRun(cancelled, timedOut, started, exitCode, states).vacuous? <==> ((((!(cancelled) && !(timedOut)) && started) && (exitCode == 0)) && (states == 0)))
  ensures (tlcRun(cancelled, timedOut, started, exitCode, states).violated? <==> ((((!(cancelled) && !(timedOut)) && started) && (exitCode >= 10)) && (exitCode <= 14)))
  ensures (tlcRun(cancelled, timedOut, started, exitCode, states).malformed? <==> (((!(cancelled) && !(timedOut)) && started) && (((exitCode == 75) || (exitCode == 150)) || (exitCode == 151))))
{
}

function runOutcome(run: ModelRun): ProofOutcome
{
  if (run.violated? || run.malformed?) then
    ProofOutcome.failed
  else
    if run.passed? then
      ProofOutcome.passed
    else
      if run.vacuous? then
        ProofOutcome.vacuous
      else
        if run.timed_out? then
          ProofOutcome.timed_out
        else
          if run.cancelled? then
            ProofOutcome.cancelled
          else
            ProofOutcome.not_started
}

lemma runOutcome_ensures(run: ModelRun)
  ensures (runOutcome(run).failed? <==> (run.violated? || run.malformed?))
  ensures (runOutcome(run).passed? <==> run.passed?)
  ensures (runOutcome(run).vacuous? <==> run.vacuous?)
  ensures (runOutcome(run).not_started? <==> run.not_started?)
