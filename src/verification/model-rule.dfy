function faultVerdict(run: ModelRun): FaultVerdict
{
  if run.violated? then
    FaultVerdict.caught
  else
    if run.passed? then
      FaultVerdict.passes
    else
      if (run.malformed? || run.vacuous?) then
        FaultVerdict.broken
      else
        FaultVerdict.unrun
}

lemma faultVerdict_ensures(run: ModelRun)
  ensures (faultVerdict(run).caught? <==> run.violated?)
  ensures (faultVerdict(run).passes? <==> run.passed?)
  ensures (faultVerdict(run).broken? <==> (run.malformed? || run.vacuous?))
  ensures (faultVerdict(run).unrun? <==> ((run.timed_out? || run.cancelled?) || run.not_started?))
