method accountUses(named: seq<string>, id: string) returns (res: seq<bool>)
  ensures (|res| == |named|)
  ensures forall i: nat :: ((i < |named|) ==> (res[i] <==> (named[i] == id)))
{
  var uses: seq<bool> := [];
  var i := 0;
  while (i < |named|)
    invariant (0 <= i)
    invariant (i <= |named|)
    invariant (|uses| == i)
    invariant forall k: nat :: ((k < i) ==> (uses[k] <==> (named[k] == id)))
  {
    uses := (uses + [(named[i] == id)]);
    i := (i + 1);
  }
  return uses;
}
