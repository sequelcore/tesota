// Generated by lsc from permission-rule.ts

datatype Mode = read | ask | full

datatype Access = read | write | run

datatype RuleVerdict = ask | allow | deny | unmatched

datatype Decision = ask | allow | deny

function decide(floor: bool, mode: Mode, access: Access, rule: RuleVerdict, present: bool): Decision
{
  if floor then
    Decision.deny
  else
    if (mode.read? && (!access.read?)) then
      Decision.deny
    else
      if rule.deny? then
        Decision.deny
      else
        if rule.allow? then
          Decision.allow
        else
          if rule.ask? then
            if present then
              Decision.ask
            else
              Decision.deny
          else
            if (mode.full? || access.read?) then
              Decision.allow
            else
              if present then
                Decision.ask
              else
                Decision.deny
}

lemma decide_ensures(floor: bool, mode: Mode, access: Access, rule: RuleVerdict, present: bool)
  ensures (floor ==> decide(floor, mode, access, rule, present).deny?)
  ensures (!(floor) ==> mode.read? ==> (!access.read?) ==> decide(floor, mode, access, rule, present).deny?)
  ensures (!(floor) ==> !((mode.read? && (!access.read?))) ==> rule.deny? ==> decide(floor, mode, access, rule, present).deny?)
  ensures (!(floor) ==> !((mode.read? && (!access.read?))) ==> rule.ask? ==> (decide(floor, mode, access, rule, present) == (if present then Decision.ask else Decision.deny)))
  ensures (!(floor) ==> !((mode.read? && (!access.read?))) ==> rule.allow? ==> decide(floor, mode, access, rule, present).allow?)
  ensures (!(floor) ==> !((mode.read? && (!access.read?))) ==> rule.unmatched? ==> (mode.full? || access.read?) ==> decide(floor, mode, access, rule, present).allow?)
  ensures (!(floor) ==> mode.ask? ==> (!access.read?) ==> rule.unmatched? ==> (decide(floor, mode, access, rule, present) == (if present then Decision.ask else Decision.deny)))
  ensures (decide(floor, mode, access, rule, present).allow? ==> (!(floor) && ((!mode.read?) || access.read?)))
  ensures (!(present) ==> (!decide(floor, mode, access, rule, present).ask?))
{
}

method strongest(matched: seq<RuleVerdict>) returns (res: RuleVerdict)
  ensures (res.deny? <==> exists k: nat :: ((k < |matched|) && matched[k].deny?))
  ensures (res.ask? <==> (!(exists k: nat :: ((k < |matched|) && matched[k].deny?)) && exists k: nat :: ((k < |matched|) && matched[k].ask?)))
  ensures (res.allow? <==> (!(exists k: nat :: ((k < |matched|) && (matched[k].deny? || matched[k].ask?))) && exists k: nat :: ((k < |matched|) && matched[k].allow?)))
  ensures (res.unmatched? <==> !(exists k: nat :: ((k < |matched|) && ((matched[k].deny? || matched[k].ask?) || matched[k].allow?))))
{
  var found := RuleVerdict.unmatched;
  var k := 0;
  while (k < |matched|)
    invariant (0 <= k)
    invariant (k <= |matched|)
    invariant (found.deny? <==> exists j: nat :: ((j < k) && matched[j].deny?))
    invariant (found.ask? <==> (!(exists j: nat :: ((j < k) && matched[j].deny?)) && exists j: nat :: ((j < k) && matched[j].ask?)))
    invariant (found.allow? <==> (!(exists j: nat :: ((j < k) && (matched[j].deny? || matched[j].ask?))) && exists j: nat :: ((j < k) && matched[j].allow?)))
    invariant (found.unmatched? <==> !(exists j: nat :: ((j < k) && ((matched[j].deny? || matched[j].ask?) || matched[j].allow?))))
  {
    if matched[k].deny? {
      found := RuleVerdict.deny;
    } else if (matched[k].ask? && (!found.deny?)) {
      found := RuleVerdict.ask;
    } else if (matched[k].allow? && found.unmatched?) {
      found := RuleVerdict.allow;
    }
    k := (k + 1);
  }
  return found;
}
