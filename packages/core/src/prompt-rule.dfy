// Generated by lsc from prompt-rule.ts

function promptStep(hasLeading: bool, sectionsChanged: bool, toolsChanged: bool): string
{
  if !(hasLeading) then
    "leading"
  else
    if (sectionsChanged || toolsChanged) then
      "change"
    else
      "none"
}

lemma promptStep_ensures(hasLeading: bool, sectionsChanged: bool, toolsChanged: bool)
  ensures (!(hasLeading) ==> (promptStep(hasLeading, sectionsChanged, toolsChanged) == "leading"))
  ensures (hasLeading ==> (sectionsChanged || toolsChanged) ==> (promptStep(hasLeading, sectionsChanged, toolsChanged) == "change"))
  ensures (hasLeading ==> !(sectionsChanged) ==> !(toolsChanged) ==> (promptStep(hasLeading, sectionsChanged, toolsChanged) == "none"))
{
}

method changedSections(previous: seq<string>, current: seq<string>) returns (res: seq<bool>)
  requires (|previous| == |current|)
  ensures (|res| == |current|)
  ensures forall i: nat :: ((i < |current|) ==> (res[i] <==> (previous[i] != current[i])))
{
  var changed: seq<bool> := [];
  var i := 0;
  while (i < |current|)
    invariant (0 <= i)
    invariant (i <= |current|)
    invariant (|changed| == i)
    invariant forall k: nat :: ((k < i) ==> (changed[k] <==> (previous[k] != current[k])))
  {
    changed := (changed + [(previous[i] != current[i])]);
    i := (i + 1);
  }
  return changed;
}
