method linesThatFit(sizes: seq<int>, maxLines: int, maxBytes: int) returns (res: int)
  requires (|sizes| >= 1)
  requires (sizes[0] == 0)
  requires (maxLines >= 0)
  requires (maxBytes >= 0)
  requires forall i: nat :: (((i + 1) < |sizes|) ==> (sizes[i] <= sizes[(i + 1)]))
  ensures (0 <= res)
  ensures (res < |sizes|)
  ensures (res <= maxLines)
  ensures (sizes[res] <= maxBytes)
  ensures ((((res + 1) == |sizes|) || (res == maxLines)) || (sizes[(res + 1)] > maxBytes))
{
  var kept := 0;
  while ((((kept + 1) < |sizes|) && (kept < maxLines)) && (sizes[(kept + 1)] <= maxBytes))
    invariant (0 <= kept)
    invariant (kept < |sizes|)
    invariant (kept <= maxLines)
    invariant (sizes[kept] <= maxBytes)
  {
    kept := (kept + 1);
  }
  return kept;
}
