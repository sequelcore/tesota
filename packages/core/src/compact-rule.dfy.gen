method cutPoint(sizes: seq<int>, starts: seq<bool>, keep: int) returns (res: int)
  requires (|sizes| == |starts|)
  ensures (0 <= res)
  ensures (res <= |sizes|)
  ensures ((res > 0) ==> ((res < |sizes|) && starts[res]))
{
  var kept := 0;
  var k := |sizes|;
  while (k > 0)
    invariant (0 <= k)
    invariant (k <= |sizes|)
  {
    k := (k - 1);
    kept := (kept + sizes[k]);
    if (((k > 0) && (kept >= keep)) && starts[k]) {
      return k;
    }
  }
  return 0;
}
