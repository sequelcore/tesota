method strongest(matched: seq<RuleVerdict>) returns (res: RuleVerdict)
  ensures (res.deny? <==> exists k: nat :: ((k < |matched|) && matched[k].deny?))
  ensures (res.ask? <==> (!(exists k: nat :: ((k < |matched|) && matched[k].deny?)) && exists k: nat :: ((k < |matched|) && matched[k].ask?)))
  ensures (res.allow? <==> (!(exists k: nat :: ((k < |matched|) && (matched[k].deny? || matched[k].ask?))) && exists k: nat :: ((k < |matched|) && matched[k].allow?)))
  ensures (res.unmatched? <==> !(exists k: nat :: ((k < |matched|) && ((matched[k].deny? || matched[k].ask?) || matched[k].allow?))))
{
  var found := RuleVerdict.unmatched;
  var k := 0;
  while (k < |matched|)
    invariant (0 <= k)
    invariant (k <= |matched|)
    invariant (found.deny? <==> exists j: nat :: ((j < k) && matched[j].deny?))
    invariant (found.ask? <==> (!(exists j: nat :: ((j < k) && matched[j].deny?)) && exists j: nat :: ((j < k) && matched[j].ask?)))
    invariant (found.allow? <==> (!(exists j: nat :: ((j < k) && (matched[j].deny? || matched[j].ask?))) && exists j: nat :: ((j < k) && matched[j].allow?)))
    invariant (found.unmatched? <==> !(exists j: nat :: ((j < k) && ((matched[j].deny? || matched[j].ask?) || matched[j].allow?))))
  {
    if matched[k].deny? {
      found := RuleVerdict.deny;
    } else if (matched[k].ask? && (!found.deny?)) {
      found := RuleVerdict.ask;
    } else if (matched[k].allow? && found.unmatched?) {
      found := RuleVerdict.allow;
    }
    k := (k + 1);
  }
  return found;
}

method within(path: seq<string>, folder: seq<string>) returns (res: bool)
  ensures (res == ((|folder| <= |path|) && forall j: nat :: ((j < |folder|) ==> (path[j] == folder[j]))))
{
  if (|folder| > |path|) {
    return false;
  }
  var k := 0;
  while (k < |folder|)
    invariant (0 <= k)
    invariant (k <= |folder|)
    invariant forall j: nat :: ((j < k) ==> (path[j] == folder[j]))
  {
    if (path[k] != folder[k]) {
      return false;
    }
    k := (k + 1);
  }
  return true;
}

method writable(path: seq<string>, folder: seq<string>, scratch: seq<string>) returns (res: bool)
  ensures (res == (((|folder| <= |path|) && forall j: nat :: ((j < |folder|) ==> (path[j] == folder[j]))) || ((|scratch| <= |path|) && forall j: nat :: ((j < |scratch|) ==> (path[j] == scratch[j])))))
{
  var i_t0 := within(path, folder);
  var i_t1 := within(path, scratch);
  return (i_t0 || i_t1);
}
