}

function meterTone(left: int): MeterTone
{
  if (left <= 0) then
    MeterTone.out
  else
    if (left <= 2500) then
      MeterTone.low
    else
      MeterTone.ok
}

lemma meterTone_ensures(left: int)
  ensures (meterTone(left).out? <==> (left <= 0))
  ensures (meterTone(left).low? <==> ((0 < left) && (left <= 2500)))
  ensures (meterTone(left).ok? <==> (left > 2500))
{
}

method usageReader(identities: seq<string>, account: int) returns (res: int)
  requires (0 <= account)
  requires (account < |identities|)
  ensures (0 <= res)
  ensures (res <= account)
  ensures ((identities[account] == "") ==> (res == account))
  ensures ((identities[account] != "") ==> (identities[res] == identities[account]))
  ensures ((identities[account] != "") ==> forall j: nat :: ((j < res) ==> (identities[j] != identities[account])))
  ensures ((identities[account] != "") ==> (res < account) ==> exists j: nat :: ((j < account) && (identities[j] == identities[account])))
  ensures ((identities[account] != "") ==> (res == account) ==> forall j: nat :: ((j < account) ==> (identities[j] != identities[account])))
{
  if (identities[account] == "") {
    return account;
  }
  var i := 0;
  while (i < account)
    invariant (0 <= i)
    invariant (i <= account)
    invariant forall j: nat :: ((j < i) ==> (identities[j] != identities[account]))
  {
    if (identities[i] == identities[account]) {
      return i;
    }
    i := (i + 1);
  }
  return account;
}
