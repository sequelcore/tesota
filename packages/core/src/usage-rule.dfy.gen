  ensures (shownPercent(left) <= 100)
  ensures ((shownPercent(left) == 0) <==> (left <= 0))
  ensures ((shownPercent(left) == 100) <==> (left >= 10000))
  ensures ((0 < left) ==> (left < 10000) ==> ((shownPercent(left) == 1) || ((shownPercent(left) * 100) <= (left + 50))))
  ensures ((0 < left) ==> (left < 10000) ==> ((shownPercent(left) == 99) || ((left + 50) < ((shownPercent(left) + 1) * 100))))
