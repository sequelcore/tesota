function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

datatype MeterTone = ok | low | out

function remainingHundredths(used: int): int
{
  if (used <= 0) then
    10000
  else
    if (used >= 10000) then
      0
    else
      (10000 - used)
}

lemma remainingHundredths_ensures(used: int)
  ensures ((used <= 0) ==> (remainingHundredths(used) == 10000))
  ensures ((used >= 10000) ==> (remainingHundredths(used) == 0))
  ensures ((0 < used) ==> (used < 10000) ==> (remainingHundredths(used) == (10000 - used)))
{
}

function filledSegments(left: int, segments: int): int
  requires (segments >= 2)
{
  if (left <= 0) then
    0
  else
    if (left >= 10000) then
      segments
    else
      var nearest := JSFloorDiv(((left * segments) + 5000), 10000);
      if (nearest < 1) then
        1
      else
        if (nearest > (segments - 1)) then
          (segments - 1)
        else
          nearest
}

lemma filledSegments_ensures(left: int, segments: int)
  requires (segments >= 2)
  ensures (0 <= filledSegments(left, segments))
  ensures (filledSegments(left, segments) <= segments)
  ensures ((filledSegments(left, segments) == 0) <==> (left <= 0))
  ensures ((filledSegments(left, segments) == segments) <==> (left >= 10000))
  ensures ((0 < left) ==> (left < 10000) ==> ((1 <= filledSegments(left, segments)) && (filledSegments(left, segments) <= (segments - 1))))
  ensures ((0 < left) ==> (left < 10000) ==> ((filledSegments(left, segments) == 1) || ((filledSegments(left, segments) * 10000) <= ((left * segments) + 5000))))
  ensures ((0 < left) ==> (left < 10000) ==> ((filledSegments(left, segments) == (segments - 1)) || (((left * segments) + 5000) < ((filledSegments(left, segments) + 1) * 10000))))
{
}

function shownPercent(left: int): int
{
  if (left <= 0) then
    0
  else
    if (left >= 10000) then
      100
    else
      var nearest := JSFloorDiv((left + 50), 100);
      if (nearest < 1) then
        1
      else
        if (nearest > 99) then
          99
        else
          nearest
}

lemma shownPercent_ensures(left: int)
