// Generated by lsc from subpath-rule.ts

function reach(segments: seq<string>, k: int): int
  requires (0 <= k)
  requires (k <= |segments|)
  decreases k
{
  if (k == 0) then
    0
  else
    var segment := segments[(k - 1)];
    (reach(segments, (k - 1)) + (if (segment == "..") then -1 else (if ((segment == ".") || (segment == "")) then 0 else 1)))
}

function above(segments: seq<string>, k: int): bool
  requires (0 <= k)
  requires (k <= |segments|)
  decreases k
{
  ((k > 0) && ((reach(segments, k) < 0) || above(segments, (k - 1))))
}

method climbsBack(segments: seq<string>) returns (res: bool)
  ensures (res <==> ((reach(segments, |segments|) <= 0) || above(segments, |segments|)))
{
  var depth := 0;
  var climbed := false;
  var k := 0;
  while (k < |segments|)
    invariant (0 <= k)
    invariant (k <= |segments|)
    invariant (depth == reach(segments, k))
    invariant (climbed == above(segments, k))
  {
    var segment := segments[k];
    depth := (depth + (if (segment == "..") then -1 else (if ((segment == ".") || (segment == "")) then 0 else 1)));
    climbed := ((depth < 0) || climbed);
    k := (k + 1);
  }
  return ((depth <= 0) || climbed);
}
