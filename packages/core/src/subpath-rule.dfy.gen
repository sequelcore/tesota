function dotOrSpaceAt(segment: string, i: int): bool
  requires (0 <= i)
  requires (i < |segment|)
{
  ((segment[i..(i + 1)] == ".") || (segment[i..(i + 1)] == " "))
}

lemma dotOrSpaceAt_ensures(segment: string, i: int)
  requires (0 <= i)
  requires (i < |segment|)
  ensures (dotOrSpaceAt(segment, i) <==> ((segment[i..(i + 1)] == ".") || (segment[i..(i + 1)] == " ")))
{
}

function reach(segments: seq<string>, k: int): int
  requires (0 <= k)
  requires (k <= |segments|)
  decreases k
{
  if (k == 0) then
    0
  else
    var segment := segments[(k - 1)];
    (reach(segments, (k - 1)) + (if (segment == "..") then -1 else (if ((segment == ".") || (segment == "")) then 0 else 1)))
}

function above(segments: seq<string>, k: int): bool
  requires (0 <= k)
  requires (k <= |segments|)
  decreases k
{
  ((k > 0) && ((reach(segments, k) < 0) || above(segments, (k - 1))))
}

method normalizeWindowsSegment(segment: string) returns (res: string)
  ensures ((forall i: nat :: ((i < |segment|) ==> dotOrSpaceAt(segment, i))) ==> (res == (if (((|segment| >= 2) && (segment[0..1] == ".")) && (segment[1..2] == ".")) then ".." else "")))
  ensures ((exists i: nat :: ((i < |segment|) && !(dotOrSpaceAt(segment, i)))) ==> (((((0 < |res|) && (|res| <= |segment|)) && (res == segment[0..|res|])) && !(dotOrSpaceAt(res, (|res| - 1)))) && forall j: nat :: ((|res| <= j) ==> (j < |segment|) ==> dotOrSpaceAt(segment, j))))
{
  var end := |segment|;
  while ((end > 0) && dotOrSpaceAt(segment, (end - 1)))
    invariant (0 <= end)
    invariant (end <= |segment|)
    invariant forall j: nat :: ((end <= j) ==> (j < |segment|) ==> dotOrSpaceAt(segment, j))
  {
    end := (end - 1);
  }
  if (end == 0) {
    return (if (((|segment| >= 2) && (segment[0..1] == ".")) && (segment[1..2] == ".")) then ".." else "");
  }
  return segment[0..end];
}

method climbsBack(segments: seq<string>) returns (res: bool)
  ensures (res <==> ((reach(segments, |segments|) <= 0) || above(segments, |segments|)))
{
  var depth := 0;
  var climbed := false;
  var k := 0;
  while (k < |segments|)
    invariant (0 <= k)
    invariant (k <= |segments|)
    invariant (depth == reach(segments, k))
    invariant (climbed == above(segments, k))
  {
    var segment := segments[k];
    depth := (depth + (if (segment == "..") then -1 else (if ((segment == ".") || (segment == "")) then 0 else 1)));
    climbed := ((depth < 0) || climbed);
    k := (k + 1);
  }
  return ((depth <= 0) || climbed);
}
