{
  "name": "@tesota/core",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "Tesota's engine: the host contract, its conformance tests and performance budgets",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "tesota": "src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun scripts/isolated.ts bun test --timeout 30000",
    "budget": "bun scripts/isolated.ts bun scripts/budget.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "check": "bun run typecheck && bun run test && bun run budget"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "cc-session-io": "0.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@xterm/headless": "5.5.0",
    "ts-morph": "25.0.1",
    "typescript": "7.0.2"
  }
}
